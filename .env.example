# Local development only. Copy to .env. Use plain KEY=value, without quotes.
# Spring reads this as Java properties; Docker Compose also reads it.
DB_URL=jdbc:mysql://127.0.0.1:3306/dhc
DB_USERNAME=root
DB_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=dhc
RABBITMQ_PASSWORD=dhc-local-password
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_SSL_ENABLED=false
NOTIFICATION_EXCHANGE=
NOTIFICATION_ROUTING_KEY=notification.test

JWT_SECRET=

ADMIN01_USERNAME=admin01
ADMIN01_PASSWORD=example-password

ADMIN02_USERNAME=admin02
ADMIN02_PASSWORD=example-password

ADMIN03_USERNAME=admin03
ADMIN03_PASSWORD=example-password

ADMIN04_USERNAME=admin04
ADMIN04_PASSWORD=example-password